# Copiare in .env e adattare:  cp .env.example .env

# --- LM Studio (endpoint compatibile OpenAI) ---
# Dai container, l'host Windows/Mac si raggiunge con host.docker.internal
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen2.5-7b-instruct
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=120

# --- Embedding (servito anch'esso da LM Studio) ---
EMBEDDING_BASE_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- Agente ---
AGENT_MAX_ITERATIONS=6

# --- Qdrant (database vettoriale) ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=wikivoyage_fvg

# --- PostgreSQL (database conversazioni) ---
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot
POSTGRES_DB=chatbot
DATABASE_URL=postgresql+psycopg://chatbot:chatbot@postgres:5432/chatbot

# --- Server MCP ---
MCP_SERVER_URL=http://mcp_server:8001/mcp

# --- Open-Meteo (nessuna chiave richiesta) ---
OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPENMETEO_TIMEOUT_S=10

# --- Porte esposte sull'host ---
FRONTEND_PORT=5173
BACKEND_PORT=8000
